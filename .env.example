# PostgreSQL. Use pooled DATABASE_URL at runtime and DIRECT_URL for migrations if your provider recommends it.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
AUTH_SECRET="replace-with-at-least-32-random-bytes"
APP_URL="http://localhost:3000"
# Optional production private uploads via Vercel Blob; upload routes fail safely if unset.
BLOB_READ_WRITE_TOKEN=""
# Optional: set true only for explicit local development use. Does not enable SQLite.
NODE_ENV="development"
